{
  "permissions": {
    "allow": [
      "Bash(npx -y @probelabs/vow@latest:*)",
      "Bash(npx -y @probelabs/vow@latest consent:*)",
      "Bash(npx -y @probelabs/vow@latest rules:*)",
      "mcp__code-search__search_code",
      "WebSearch",
      "Bash(php artisan tinker:*)",
      "Bash(npx prisma *)",
      "Bash(powershell -NoProfile -Command \"Get-Process node -ErrorAction SilentlyContinue | Select-Object Id,ProcessName,Path\")",
      "PowerShell(Get-CimInstance Win32_Process -Filter \"Name='node.exe'\")",
      "PowerShell(taskkill /PID 23208 /T /F 2>&1)",
      "PowerShell(taskkill /PID 17420 /T /F 2>&1)",
      "Bash(npx tsc *)",
      "Bash(node -e ' *)",
      "Bash(npx vitest *)",
      "Bash(npx eslint *)",
      "Bash(npm run *)",
      "Bash(curl -s http://localhost:3001/api/health)",
      "Read(//tmp/**)",
      "PowerShell(taskkill /PID 41600 /T /F)",
      "Bash(curl -s -w \"\\\\nHTTP_STATUS:%{http_code}\\\\n\" http://localhost:3001/api/health)",
      "PowerShell(taskkill /PID 3632 /T /F)",
      "PowerShell(taskkill /PID 32752 /T /F)",
      "Bash(curl -s -w \"\\\\nHTTP:%{http_code}\\\\n\" http://localhost:3001/api/health)",
      "Bash(curl -s -o /dev/null -w \"client\\(5173\\): %{http_code}\\\\n\" http://localhost:5173 --max-time 3)",
      "Bash(curl -s -o /dev/null -w \"server\\(3001\\): %{http_code}\\\\n\" http://localhost:3001/api/health --max-time 3)",
      "PowerShell(Get-NetTCPConnection -LocalPort 3001,5173 -State Listen -ErrorAction SilentlyContinue)",
      "Bash(curl -s -w \"\\\\nserver: %{http_code}\\\\n\" http://localhost:3001/api/health --max-time 3)",
      "Bash(curl -s -o /dev/null -w \"client: %{http_code}\\\\n\" http://localhost:5173 --max-time 3)",
      "Bash(chromium-cli --help)",
      "Bash(node -e \"require.resolve\\('playwright'\\)\")",
      "Bash(npx --no-install playwright --version)",
      "Bash(npm ls *)",
      "Bash(curl -s http://localhost:5173/)",
      "Bash(curl -s http://localhost:5173/src/main.tsx -o /dev/null -w \"main.tsx: %{http_code}\\\\n\")",
      "Bash(curl -s -o /dev/null -w \"auth/me \\(expect 200 with null-safe body or 401\\): %{http_code}\\\\n\" http://localhost:3001/api/auth/me)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "npx @probelabs/vow check --hook --hook-type=PreToolUseGit"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx @probelabs/vow check --hook --hook-type=Stop"
          }
        ]
      }
    ]
  }
}
