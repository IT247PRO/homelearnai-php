{
  "name": "@homelearnai/database",
  "private": true,
  "version": "0.1.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "DATABASE_URL=\"${DATABASE_URL:-file:./dev.db}\" prisma migrate deploy",
    "seed": "DATABASE_URL=\"${DATABASE_URL:-file:./dev.db}\" tsx seeds/index.ts",
    "studio": "DATABASE_URL=\"${DATABASE_URL:-file:./dev.db}\" prisma studio",
    "reset": "DATABASE_URL=\"${DATABASE_URL:-file:./dev.db}\" prisma migrate reset --force"
  },
  "prisma": {
    "seed": "tsx seeds/index.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
