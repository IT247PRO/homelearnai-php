{
  "name": "homelearnai-v2",
  "private": true,
  "version": "0.1.0",
  "description": "React + Node.js + SQLite rewrite of HomeLearnAI (see /src-v2). Original Laravel app remains at repo root for reference.",
  "workspaces": [
    "client",
    "server",
    "database"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run build --workspace=client && cp -r client/dist dist && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "npm run lint --workspace=client",
    "db:generate": "npm run generate --workspace=database",
    "db:migrate": "npm run migrate:deploy --workspace=database",
    "db:seed": "npm run seed --workspace=database",
    "db:studio": "npm run studio --workspace=database",
    "db:reset": "npm run reset --workspace=database"
  },
  "devDependencies": {
    "@prisma/client": "^6.1.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "concurrently": "^9.1.0",
    "esbuild": "^0.28.2",
    "prisma": "^6.1.0",
    "tsx": "^4.23.12"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "@vitejs/plugin-react": "^6.1.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "node-ical": "^0.27.1",
    "vite": "^8.2.2",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  }
}
