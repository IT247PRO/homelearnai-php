NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Prisma reads this from database/.env at generate/migrate time; the server
# only needs it if DATABASE_URL isn't already set in the shared environment.
DATABASE_URL="file:./dev.db"

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Parent PIN pepper for hashing Kids Mode PINs (in addition to per-record salt)
PIN_HASH_PEPPER=change-me-in-production

# Real local AI provider for this dev environment — no key needed.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest
