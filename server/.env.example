NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# The generated Prisma Client resolves a relative SQLite `file:` URL relative to the
# schema.prisma file's own directory (database/prisma/), not this process's cwd — so this
# must use the exact same value as database/.env, even though the server runs elsewhere.
DATABASE_URL="file:./dev.db"

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Parent PIN pepper for hashing Kids Mode PINs (in addition to per-record salt)
PIN_HASH_PEPPER=change-me-in-production

# Leave unset to run with the clean "not configured" AiProvider (no live key, no faked
# responses). Set to "ollama", "openai", or "anthropic" to activate a real adapter.
# AI_PROVIDER=

# ollama — talks to a local Ollama instance (https://ollama.com), no API key needed.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# openai — requires an API key from platform.openai.com.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# anthropic — requires an API key from console.anthropic.com.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
